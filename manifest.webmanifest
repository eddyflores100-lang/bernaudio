{
  "id": "./app.html",
  "name": "BernAudio · Analizador de campo",
  "short_name": "BernAudio",
  "description": "Analizador de audio para eventos, mediciones por zonas y sesiones de campo.",
  "lang": "es",
  "start_url": "./app.html?source=installed",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#101214",
  "theme_color": "#101214",
  "prefer_related_applications": false,
  "categories": [
    "music",
    "utilities",
    "productivity"
  ],
  "icons": [
    {
      "src": "assets/pwa-icon.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "assets/pwa-icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "assets/pwa-icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Medición por zonas",
